<?php

/**
 * @file
 * Hook implementations for the RSS Aggregator module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function rss_aggregator_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.rss_aggregator':
      $output = '<p>' . t('The RSS Aggregator module fetches external RSS or Atom feeds, pushes items through the Queue API and stores them as a dedicated content entity. Feed sources are a config entity ("RSS feed"); imported items are content entities ("RSS item").') . '</p>';
      $output .= '<p>' . t('Manage feed sources on the <a href=":feeds">RSS feeds</a> page and review module settings under <a href=":settings">RSS importer settings</a>.', [
        ':feeds' => '/admin/config/services/rss-feeds',
        ':settings' => '/admin/config/services/rss-feeds/settings',
      ]) . '</p>';
      return $output;
  }
}

/**
 * Implements hook_cron().
 *
 * Enqueues every enabled feed whose refresh interval has elapsed into the
 * "rss_aggregator_feeds" queue, then prunes expired items.
 */
function rss_aggregator_cron() {
  $now = (int) \Drupal::time()->getRequestTime();

  /** @var \Drupal\rss_aggregator\FeedFetcher $fetcher */
  $fetcher = \Drupal::service('rss_aggregator.feed_fetcher');
  $feeds = \Drupal::entityTypeManager()->getStorage('rss_feed')->loadByProperties(['status' => TRUE]);

  $enqueued = 0;
  if ($feeds) {
    foreach ($feeds as $feed) {
      if ($feed->isDue($now)) {
        if ($fetcher->enqueueFeed($feed->id())) {
          // Advance the schedule immediately so a single cron run never
          // enqueues the same feed twice, even if a queue backlog exists.
          $feed
            ->setNextRefresh($now + $feed->getRefreshInterval() * 60)
            ->save();
          $enqueued++;
        }
      }
    }
    \Drupal::logger('rss_aggregator')->info('Cron enqueued @count feed(s) for processing.', ['@count' => $enqueued]);
  }

  // Prune expired items. item_lifetime is in days; 0 = keep forever.
  $lifetime = (int) \Drupal::config('rss_aggregator.settings')->get('item_lifetime');
  if ($lifetime > 0) {
    $cutoff = $now - $lifetime * 86400;
    $ids = \Drupal::entityQuery('rss_item')
      ->accessCheck(FALSE)
      ->condition('created', $cutoff, '<')
      ->execute();
    if (!empty($ids)) {
      $storage = \Drupal::entityTypeManager()->getStorage('rss_item');
      $storage->delete($storage->loadMultiple($ids));
      \Drupal::logger('rss_aggregator')->info('Deleted @count expired RSS item(s).', ['@count' => count($ids)]);
    }
  }
}
